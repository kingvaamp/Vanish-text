# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo — do NOT ignore dist/ — we commit pre-built web assets for Render deployment
# (Render free tier, 512 MB RAM, cannot run expo export without OOM-kill)
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
.env.local
.env.*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
